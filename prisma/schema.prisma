generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model PaperAnalysis {
  id                    String   @id @default(cuid())
  title                 String
  abstract              String
  keywords              String
  sections              String
  references            String
  uploadedAt            DateTime @default(now())
  journalScore          Int
  acceptanceProbability String
  suggestions           String
}
